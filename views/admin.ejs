<div class="modal" id="milestoneModal">
  <div class="modal-box" style="width:520px">
    <div class="modal-header">
      <div>
        <h3>Add New Milestone</h3>
        <div class="subtitle">Create a new construction milestone</div>
      </div>
      <span class="close" onclick="closeMilestoneModal()">×</span>
    </div>

    <div class="form-grid">
      <input id="milestoneDescription" placeholder="Milestone Description (e.g., Foundation)">
      <input id="milestonePlannedDate" type="date" placeholder="Planned Date">
      <input id="milestoneCompletionDate" type="date" placeholder="Completion Date (optional)">
      <select id="milestoneStatus">
        <option value="Planned">Planned</option>
