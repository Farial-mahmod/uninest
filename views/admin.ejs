      if (status === 'Completed') progress = 100;
      else if (status === 'In Progress') progress = 50;
      else if (status === 'Delayed') progress = 25;
      else progress = 0;
      
      const row = `
        <tr>
          <td>
            <div style="font-weight: 600;">${milestone.description || 'Untitled Milestone'}</div>
            ${milestone.note ? `<div style="font-size: 12px; color: #666; margin-top: 4px;">
              📝 ${milestone.note}
            </div>` : ''}
          </td>
          <td>
            <div>${plannedDate ? formatDate(plannedDate) : 'Not set'}</div>
            ${completionDate ? `<div style="font-size: 12px; color: #059669; margin-top: 2px;">
              Completed: ${formatDate(completionDate)}
            </div>` : ''}
          </td>
          <td>
            <span class="status-badge" style="
              background: ${statusColors[status] || '#6b7280'};
              color: white;
              padding: 4px 12px;
              border-radius: 20px;
              font-size: 12px;
              font-weight: 500;
            ">
              ${status}
            </span>
          </td>
          <td>
            <div style="display: flex; align-items: center; gap: 8px;">
              <div style="flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden;">
                <div style="width: ${progress}%; height: 100%; background: ${statusColors[status] || '#6b7280'};"></div>
              </div>
              <span style="font-size: 12px; color: #666; min-width: 30px;">${progress}%</span>
            </div>
          </td>
          <td>
            <button class="btn-small" onclick="openEditMilestoneModal(${index})">Edit</button>
          </td>
        </tr>
      `;
      tableBody.insertAdjacentHTML('beforeend', row);
    });
    
  } catch (err) {
    console.error('Failed to load milestones:', err);
    showEmptyMilestones();
  }
}

// Function to open edit modal with milestone data
function openEditMilestoneModal(index) {
  // Check if milestone exists at this index
  if (!milestonesData || !milestonesData[index]) {
    alert('Milestone not found!');
    return;
  }
  
  const milestone = milestonesData[index];
  
  // Populate form fields
  document.getElementById('editMilestoneDescription').value = milestone.description || '';
  
  // Convert DD-MM-YYYY to YYYY-MM-DD for date inputs
  const convertToYYYYMMDD = (dateString) => {
    if (!dateString) return '';
    const parts = dateString.split('-');
    if (parts.length === 3) {
      const day = parts[0];
      const month = parts[1];
      const year = parts[2];
      return `${year}-${month}-${day}`;
    }
    return dateString;
  };
  
  document.getElementById('editMilestonePlannedDate').value = convertToYYYYMMDD(milestone.planned_date);
  document.getElementById('editMilestoneCompletionDate').value = convertToYYYYMMDD(milestone.completion_date);
  document.getElementById('editMilestoneStatus').value = milestone.status || 'Planned';
  document.getElementById('editMilestoneNote').value = milestone.note || '';
  
  // Store index and ID for update
  document.getElementById('editMilestoneIndex').value = index;
  document.getElementById('editMilestoneId').value = milestone._id || '';
  
  // Show modal
  document.getElementById('editMilestoneModal').classList.add('active');
}

// Function to close edit modal
function closeEditMilestoneModal() {
  document.getElementById('editMilestoneModal').classList.remove('active');
  // Clear form fields
  document.getElementById('editMilestoneDescription').value = '';
  document.getElementById('editMilestonePlannedDate').value = '';
  document.getElementById('editMilestoneCompletionDate').value = '';
  document.getElementById('editMilestoneStatus').value = 'Planned';
  document.getElementById('editMilestoneNote').value = '';
  document.getElementById('editMilestoneIndex').value = '';
  document.getElementById('editMilestoneId').value = '';
}

// Function to update milestone
async function updateMilestone() {
  try {
    const index = document.getElementById('editMilestoneIndex').value;
    const milestoneId = document.getElementById('editMilestoneId').value;
    
    // Get form values
    const description = document.getElementById('editMilestoneDescription').value;
    const planned_date = document.getElementById('editMilestonePlannedDate').value;
    const completion_date = document.getElementById('editMilestoneCompletionDate').value;
    const status = document.getElementById('editMilestoneStatus').value;
    const note = document.getElementById('editMilestoneNote').value;
    
    // Validate required fields
    if (!description || !planned_date) {
      alert('Description and Planned Date are required');
      return;
    }
    
    // Format dates to DD-MM-YYYY
    const formatDateToDDMMYYYY = (dateString) => {
      if (!dateString) return '';
      const date = new Date(dateString);
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}-${month}-${year}`;
    };
    
    // Prepare payload
    const payload = {
      index: parseInt(index),
      description: description.trim(),
      planned_date: formatDateToDDMMYYYY(planned_date),
      completion_date: completion_date ? formatDateToDDMMYYYY(completion_date) : '',
      status: status,
      note: note ? note.trim() : ''
    };
    
    console.log('Updating milestone:', payload);
    
    // Send PUT request to API
    const res = await fetch(`/api/milestones/aurora/${index}`, {
      method: 'PUT',
      headers: { 
        'Content-Type': 'application/json' 
      },
      body: JSON.stringify(payload)
    });
    
    // Check response
    if (!res.ok) {
      const errorText = await res.text();
      console.error('API Error:', errorText);
      throw new Error(`Failed to update milestone: ${res.status} ${res.statusText}`);
    }
    
    const result = await res.json();
    console.log('API Response:', result);
    
    // Close modal and show success
    closeEditMilestoneModal();
    showSuccessPopup('Milestone updated successfully');
    
    // Refresh milestones list
    fetchMilestones();
    
  } catch (err) {
    console.error('Error updating milestone:', err);
    alert('Error updating milestone: ' + err.message);
  }
}
