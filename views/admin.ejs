<script>

  // Load projects into the dropdown

// Load projects into the dropdown
async function loadProjectsForSelector() {
  const projectSelect = document.getElementById('projectSelector');
  
  try {
    projectSelect.innerHTML = '<option value="">-- Loading Projects --</option>';
    
    const response = await fetch('/api/projects');
    
    if (!response.ok) {
      throw new Error('Failed to fetch projects');
    }
    
    const result = await response.json();
    
    projectSelect.innerHTML = '<option value="">-- Select Project --</option>';
    
    // Get projects from response
    let projects = [];
    if (result.success && result.projects) {
      projects = result.projects;
    } else if (Array.isArray(result)) {
      projects = result;
    }
    
    if (projects.length > 0) {
      projects.forEach(project => {
        const option = document.createElement('option');
        option.value = project;
        option.textContent = formatProjectDisplayName(project);
        projectSelect.appendChild(option);
      });
    } else {
      // Fallback projects
      const fallbackProjects = ['aurora', 'greenescape', 'godhuli'];
      fallbackProjects.forEach(project => {
        const option = document.createElement('option');
        option.value = project;
        option.textContent = formatProjectDisplayName(project);
        projectSelect.appendChild(option);
      });
    }
    
    // Add event listener to load users when project changes
    projectSelect.addEventListener('change', function() {
      // Clear user selector when project changes
      const userSelect = document.getElementById('userSelector');
      if (userSelect) {
        userSelect.innerHTML = '<option value="">-- Select Project First --</option>';
      }
      // Clear payments list
      const paymentsList = document.getElementById('paymentsList');
      if (paymentsList) {
        paymentsList.innerHTML = '';
      }
      document.getElementById('paymentsTotal').style.display = 'none';
    });
    
  } catch (error) {
    console.error('Error loading projects:', error);
    projectSelect.innerHTML = '<option value="">-- Error Loading Projects --</option>';
    
    // Add fallback options
    setTimeout(() => {
      projectSelect.innerHTML = '<option value="">-- Select Project --</option>';
      const fallbackProjects = ['aurora', 'greenescape', 'godhuli'];
      fallbackProjects.forEach(project => {
        const option = document.createElement('option');
        option.value = project;
        option.textContent = formatProjectDisplayName(project);
        projectSelect.appendChild(option);
      });
    }, 1000);
  }
}

// Format project name for display
function formatProjectDisplayName(projectName) {
  const displayNames = {
    'aurora': 'UniNest Aurora',
    'godhuli': 'UniNest Godhuli',
    'greenescape': 'UniNest Green Escape'
  };
  
  return displayNames[projectName] || 
    projectName.charAt(0).toUpperCase() + projectName.slice(1).replace(/([A-Z])/g, ' $1').trim();
}

// Load shareholders for selected project

// Load shareholders for selected project
async function loadShareholdersForProject() {
  const projectSelect = document.getElementById('projectSelector');
  const project = projectSelect.value;
  
  if (!project) {
    alert('Please select a project');
    return;
  }
  
  const tableBody = document.getElementById('tableBody');
  tableBody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px;">Loading shareholders...</td></tr>';
  
  try {
    // Use the selected project name in the API call
    const response = await fetch(`/api/shareholder/${project}`);
    
    if (!response.ok) {
      if (response.status === 404) {
        tableBody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px; color: #666;">No shareholders found for this project</td></tr>';
        return;
      }
      throw new Error('Failed to fetch shareholders');
    }
    
    const shareholders = await response.json();
    
    if (!shareholders || shareholders.length === 0) {
      tableBody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px; color: #666;">No shareholders found for this project</td></tr>';
      return;
    }
    
    // Clear and populate table
    tableBody.innerHTML = '';
    
    shareholders.forEach((sh, index) => {
      // Calculate total paid
      const totalPaid = (sh.payments || [])
        .reduce((sum, p) => sum + (p.amount_paid || 0), 0);
      
      const row = `
        <tr>
          <td>${sh.id || 'N/A'}</td>
          <td>${sh.name || 'N/A'}</td>
          <td>${sh.flat_number || 'N/A'}</td>
          <td>${sh.mobile || 'N/A'}</td>
          <td>৳${totalPaid.toLocaleString()}</td>
          <td>
            <span style="background: ${sh.role === 'admin' ? '#dc2626' : '#059669'}; 
                         color: white; padding: 4px 8px; border-radius: 12px; font-size: 12px;">
              ${sh.role || 'client'}
            </span>
          </td>
          <td>
            <button onclick="deleteShareholder('${project}', '${sh.id}', '${sh.name}')" 
                    style="background: #dc2626; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px;">
              Delete
            </button>
          </td>
        </tr>
      `;
      
      tableBody.insertAdjacentHTML('beforeend', row);
    });
    
  } catch (err) {
