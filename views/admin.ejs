// Function to open edit modal with milestone data
function openEditMilestoneModal(index) {
  // Check if milestone exists at this index
  if (!milestonesData || !milestonesData[index]) {
    alert('Milestone not found!');
    return;
  }
  
  const milestone = milestonesData[index];
  
  // Populate form fields
  document.getElementById('editMilestoneDescription').value = milestone.description || '';
  
  // Convert DD-MM-YYYY to YYYY-MM-DD for date inputs
  const convertToYYYYMMDD = (dateString) => {
    if (!dateString) return '';
    const parts = dateString.split('-');
    if (parts.length === 3) {
      const day = parts[0];
      const month = parts[1];
      const year = parts[2];
      return `${year}-${month}-${day}`;
    }
    return dateString;
  };
  
  document.getElementById('editMilestonePlannedDate').value = convertToYYYYMMDD(milestone.planned_date);
  document.getElementById('editMilestoneCompletionDate').value = convertToYYYYMMDD(milestone.completion_date);
  document.getElementById('editMilestoneStatus').value = milestone.status || 'Planned';
  document.getElementById('editMilestoneNote').value = milestone.note || '';
  
  // Store index and ID for update
  document.getElementById('editMilestoneIndex').value = index;
  document.getElementById('editMilestoneId').value = milestone._id || '';
  
  // Show modal
  document.getElementById('editMilestoneModal').classList.add('active');
}

