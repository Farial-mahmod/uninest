function openPaymentModal() {
  // Clear form fields
  document.getElementById('paymentInstallment').value = '';
  document.getElementById('paymentAmount').value = '';
  
  // MODIFIED: Set default date to 10th of current month
  const today = new Date();
  const tenthOfMonth = new Date(today.getFullYear(), today.getMonth(), 11);
  const formattedDate = tenthOfMonth.toISOString().split('T')[0];
  document.getElementById('paymentDate').value = formattedDate;
  
  // Populate shareholders dropdown
  populatePaymentShareholders();
  
  // Show modal
  document.getElementById('paymentModal').classList.add('active');
