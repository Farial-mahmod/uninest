// Load projects into both selectors
async function loadProjectsForSelectors() {
  const projectSelect = document.getElementById('projectSelector');
  const paymentProjectSelect = document.getElementById('paymentProjectSelector');
  
  try {
    projectSelect.innerHTML = '<option value="">-- Loading Projects --</option>';
    if (paymentProjectSelect) {
      paymentProjectSelect.innerHTML = '<option value="">-- Loading Projects --</option>';
    }
    
    const response = await fetch('/api/projects');
    
    if (!response.ok) {
      throw new Error('Failed to fetch projects');
    }
    
    const result = await response.json();
    
    // Get projects from response
    let projects = [];
    if (result.success && result.projects) {
      projects = result.projects;
    } else if (Array.isArray(result)) {
      projects = result;
    }
    
    // Use the projects from the response, or fallback to hardcoded ones
    const projectsToUse = projects.length > 0 ? projects : ['aurora', 'greenescape', 'godhuli'];
    
    // Populate both selectors
    projectSelect.innerHTML = '<option value="">-- Select Project --</option>';
    if (paymentProjectSelect) {
      paymentProjectSelect.innerHTML = '<option value="">-- Select Project --</option>';
    }
    
    projectsToUse.forEach(project => {
      const option = document.createElement('option');
      option.value = project;
      option.textContent = formatProjectDisplayName(project);
      projectSelect.appendChild(option);
      
      if (paymentProjectSelect) {
        const paymentOption = document.createElement('option');
        paymentOption.value = project;
        paymentOption.textContent = formatProjectDisplayName(project);
        paymentProjectSelect.appendChild(paymentOption);
      }
    });
    
    console.log('Projects loaded:', projectsToUse);
    
  } catch (error) {
    console.error('Error loading projects:', error);
    projectSelect.innerHTML = '<option value="">-- Error Loading Projects --</option>';
    if (paymentProjectSelect) {
      paymentProjectSelect.innerHTML = '<option value="">-- Error Loading Projects --</option>';
    }
    
    // Add fallback options
    setTimeout(() => {
      projectSelect.innerHTML = '<option value="">-- Select Project --</option>';
      if (paymentProjectSelect) {
        paymentProjectSelect.innerHTML = '<option value="">-- Select Project --</option>';
      }
      
      const fallbackProjects = ['aurora', 'greenescape', 'godhuli'];
      fallbackProjects.forEach(project => {
        const option = document.createElement('option');
        option.value = project;
        option.textContent = formatProjectDisplayName(project);
        projectSelect.appendChild(option);
        
        if (paymentProjectSelect) {
          const paymentOption = document.createElement('option');
          paymentOption.value = project;
          paymentOption.textContent = formatProjectDisplayName(project);
          paymentProjectSelect.appendChild(paymentOption);
        }
      });
    }, 1000);
  }
}

