function updateGalleryGrid(files) {
  const galleryGrid = document.querySelector('.gallery-grid');
  galleryGrid.innerHTML = '';
  
  files.forEach(file => {
    const mediaType = file.metadata.mediaType || 'image';
    const card = document.createElement('div');
    card.className = 'gallery-card';
    card.onclick = () => openMedia(mediaType, `${file.filename}`);
    
    card.innerHTML = `
      <img src="${file.filename}" alt="${file.metadata.description}">
      <div class="gallery-info">
        <strong>${file.metadata.description || file.originalName}</strong>
        <div class="subtitle">${file.metadata.project || 'Project'}</div>
        <small>${new Date(file.metadata.dateCaptured || file.uploadDate).toLocaleDateString()}</small>
      </div>
    `;
    
    galleryGrid.appendChild(card);
  });
