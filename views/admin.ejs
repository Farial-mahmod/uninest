}

.option-item {
  text-align: center;
  padding: 15px;
  border: 1px solid #eee;
  border-radius: 8px;
  transition: all 0.3s;
  cursor: pointer;
}

.option-item:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
}

.option-item.selected {
  border-color: var(--primary);
  background: rgba(52, 152, 219, 0.05);
}

.option-item img {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: 6px;
  margin-bottom: 10px;
}

.option-item h4 {
  margin: 0 0 5px 0;
  font-size: 14px;
}

.option-item p {
  margin: 0;
