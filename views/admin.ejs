    const option3Image = document.getElementById('option3Image').files[0];
    const option3Url = document.getElementById('option3Url').value.trim();
    
    // Upload images and get URLs
    const imageUrls = await Promise.all([
      uploadImageAndGetUrl(option1Image, option1Url, 'option1'),
      uploadImageAndGetUrl(option2Image, option2Url, 'option2'),
      uploadImageAndGetUrl(option3Image, option3Url, 'option3')
    ]);
    
    // Format dates
    const formatDate = (dateString) => {
      const date = new Date(dateString);
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}-${month}-${year}`;
    };
    
    // Create payload matching API format exactly
    const payload = {
      name: optionName,
      description: optionDescription,
      from: formatDate(optionFrom),
      to: formatDate(optionTo),
      option_1: {
        details: option1Description,
        url: imageUrls[0]
      },
      option_2: {
        details: option2Description,
        url: imageUrls[1]
      },
      option_3: {
        details: option3Description,
        url: imageUrls[2]
      }
    };
    
    console.log('Sending payload:', payload);
    
    // Send to server
    const project = 'aurora';
    const res = await fetch(`/api/customization/${project}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(payload)
    });
    
    if (!res.ok) {
      const errorText = await res.text();
      throw new Error(`Server error: ${errorText}`);
    }
    
    const result = await res.json();
    console.log('Success:', result);
    
    // Show success message
    showSuccessPopup('Customization option added successfully!');
    
    // Close modal and refresh
    closeAddOptionModal();
    setTimeout(() => {
      fetchCustomization();
    }, 500);
    
  } catch (error) {
    console.error('Upload failed:', error);
    alert(`Error: ${error.message}`);
  }
}

async function uploadImageAndGetUrl(file, url, optionName) {
  // If URL provided, use it
  if (url && isValidUrl(url)) {
    return url;
  }
  
  // If file provided, upload it
  if (file) {
    return await uploadImageFile(file, optionName);
  }
  
  // Return placeholder if neither
  return 'https://via.placeholder.com/400x300?text=No+Image';
}

async function uploadImageFile(file, optionName) {
  const formData = new FormData();
  formData.append('file', file);
  formData.append('name', optionName);
  formData.append('description', 'Customization option image');
  formData.append('date', new Date().toISOString().split('T')[0]);
  
  try {
    const res = await fetch('/api/upload-media', {
      method: 'POST',
      body: formData
    });
    
    if (!res.ok) {
      throw new Error('Image upload failed');
    }
    
    const data = await res.json();
    return data.data.url;
    
  } catch (error) {
    console.error('Image upload error:', error);
    return 'https://via.placeholder.com/400x300?text=Upload+Failed';
  }
}

// 6. Show success popup
function showSuccessPopup(message) {
  // Remove existing popup
  const existingPopup = document.querySelector('.success-popup');
  if (existingPopup) existingPopup.remove();
  
  // Create new popup
  const popup = document.createElement('div');
  popup.className = 'success-popup';
  popup.textContent = message;
  document.body.appendChild(popup);
  
  // Remove after animation
  setTimeout(() => {
    popup.remove();
  }, 3000);
}

// 7. Update tab switching function
function showTab(tab, el) {
  const views = {
    shareholders: 'shareholdersView',
    payments: 'paymentsView',
    costs: 'costsView',
    milestones: 'milestonesView',  
    gallery: 'galleryView',     
    customization: 'customizationView' 
  };

  // Hide all views
  Object.values(views).forEach(id => {
    const view = document.getElementById(id);
    if (view) view.style.display = 'none';
  });

  // Show selected view
  const activeView = document.getElementById(views[tab]);
  if (activeView) {
    activeView.style.display = 'block';
  }
  // Activate tab UI
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  // Lazy-load data
  if (tab === 'payments') fetchPayments();
  if (tab === 'costs') fetchCosts(); 
  if (tab === 'milestones') fetchMilestones();
  if (tab === 'gallery') fetchGallery();
  if (tab === 'customization') fetchCustomization();
}

function toggleProfileMenu(event) {
  event.stopPropagation();
  document.getElementById("profileMenu").classList.toggle("show");
}

// Close the dropdown if the user clicks outside of it
window.onclick = function(event) {
  if (!event.target.matches('.tab')) {
    var dropdowns = document.getElementsByClassName("dropdown-content");
    for (var i = 0; i < dropdowns.length; i++) {
      var openDropdown = dropdowns[i];
      if (openDropdown.classList.contains('show')) {
        openDropdown.classList.remove('show');
      }
    }
  }
}

