// Delete shareholder function
async function deleteShareholder(project, shareholderId, shareholderName) {
  // Confirm deletion
  if (!confirm(`Are you sure you want to delete ${shareholderName} (ID: ${shareholderId})?`)) {
    return;
  }
  
  try {
    const response = await fetch(`/api/shareholder/${project}/${shareholderId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    });
    
    const result = await response.json();
    
    if (!response.ok) {
      throw new Error(result.message || 'Failed to delete shareholder');
    }
    
    // Show success message
    showSuccessPopup(`Shareholder ${shareholderName} deleted successfully`);
    
    // Refresh the shareholders list
    loadShareholdersForProject();
    
  } catch (err) {
    console.error('Delete shareholder error:', err);
    alert(`Error deleting shareholder: ${err.message}`);
  }
}

