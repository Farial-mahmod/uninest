async function submitPayment() {
  // Get values from payment modal
  const shareholderId = document.getElementById('paymentShareholder').value;
  const installmentNumber = document.getElementById('paymentInstallment').value;
  const amountPaid = document.getElementById('paymentAmount').value;
  const paymentDate = document.getElementById('paymentDate').value;

  // Validate all fields are filled
  if (!shareholderId || !installmentNumber || !amountPaid || !paymentDate) {
    alert('All fields are required');
    return;
  }

  const payload = {
    shareholderId: shareholderId,
    installment_number: parseInt(installmentNumber),
    amount_paid: parseFloat(amountPaid),
    payment_date: paymentDate
  };

  try {
    const res = await fetch('/api/payment/aurora', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    
    if (!res.ok) throw new Error(result.message || 'Failed to record payment');

    closePaymentModal();
    showSuccessPopup('Payment recorded successfully');
    
    // Clear form fields
    document.getElementById('paymentInstallment').value = '';
    document.getElementById('paymentAmount').value = '';
    document.getElementById('paymentDate').value = '';
    document.getElementById('paymentShareholder').value = '';

    fetchPayments(); // Refresh payments list

  } catch (err) {
    alert('Error recording payment: ' + err.message);
  }
}

// Load users into the dropdown based on selected project
async function loadUsersForSelector() {
  const projectSelect = document.getElementById('projectSelector');
  const userSelect = document.getElementById('userSelector');
  const project = projectSelect.value;
  
  if (!project) {
    userSelect.innerHTML = '<option value="">-- Select Project First --</option>';
    return;
  }
  
  try {
    userSelect.innerHTML = '<option value="">-- Loading Users --</option>';
    userSelect.disabled = true;
    
    const response = await fetch(`/api/shareholder/${project}`);
    
    if (!response.ok) {
      throw new Error('Failed to fetch users');
    }
    
    const shareholders = await response.json();
    
    userSelect.innerHTML = '<option value="">-- Select User --</option>';
    userSelect.disabled = false;
    
    // Filter out admin users if you want only clients with payments
    const users = shareholders.filter(sh => sh.role !== 'admin');
    
    if (users.length === 0) {
      userSelect.innerHTML = '<option value="">-- No users found --</option>';
      return;
    }
    
    users.forEach(user => {
      const option = document.createElement('option');
      option.value = JSON.stringify({
        id: user.id,
        name: user.name,
        flat: user.flat_number
      });
      option.textContent = `${user.name} (${user.flat_number || 'No Flat'})`;
      userSelect.appendChild(option);
    });
    
  } catch (error) {
    console.error('Error loading users:', error);
    userSelect.innerHTML = '<option value="">-- Error Loading Users --</option>';
    userSelect.disabled = false;
  }
}

// Load payments for selected user
async function loadUserPayments() {
  const projectSelect = document.getElementById('projectSelector');
  const userSelect = document.getElementById('userSelector');
  const paymentsList = document.getElementById('paymentsList');
  const paymentsTotal = document.getElementById('paymentsTotal');
  const totalAmountSpan = document.getElementById('totalAmount');
  
  const project = projectSelect.value;
  const selectedUser = userSelect.value;
  
  if (!project) {
    alert('Please select a project first');
    return;
  }
  
  if (!selectedUser) {
    alert('Please select a user');
    return;
  }
  
  try {
    const userData = JSON.parse(selectedUser);
    paymentsList.innerHTML = '<div style="text-align: center; padding: 40px;">Loading payments...</div>';
    paymentsTotal.style.display = 'none';
    
    const response = await fetch(`/api/shareholder/${project}`);
    
    if (!response.ok) {
      throw new Error('Failed to fetch user data');
    }
    
    const shareholders = await response.json();
    const user = shareholders.find(sh => sh.id === userData.id);
    
    if (!user) {
      paymentsList.innerHTML = '<div style="text-align: center; padding: 40px; color: #666;">User not found</div>';
      return;
    }
    
    // Get payments and filter out unpaid ones if desired
    const payments = user.payments || [];
    const paidPayments = payments.filter(p => p.amount_paid > 0);
    
    if (paidPayments.length === 0) {
      paymentsList.innerHTML = '<div style="text-align: center; padding: 40px; color: #666;">No payments found for this user</div>';
      paymentsTotal.style.display = 'none';
      return;
    }
    
    // Calculate total
    const total = paidPayments.reduce((sum, p) => sum + (p.amount_paid || 0), 0);
    
    // Display payments
    let html = `
      <h3>Payments for ${user.name} (${user.flat_number || 'No Flat'})</h3>
      <div style="margin-top: 20px;">
    `;
    
    paidPayments.sort((a, b) => (a.installment_number || 0) - (b.installment_number || 0));
    
    paidPayments.forEach(payment => {
      const paymentDate = payment.payment_date || 'N/A';
      const amount = payment.amount_paid || 0;
      
      html += `
        <div class="payment-row" style="display: flex; justify-content: space-between; align-items: center; padding: 15px; border-bottom: 1px solid #eee;">
          <div>
            <strong>Installment ${payment.installment_number || 'N/A'}</strong>
            <div class="subtitle">Date: ${paymentDate}</div>
          </div>
          <div style="font-weight: bold; color: #059669;">৳${amount.toLocaleString()}</div>
        </div>
      `;
    });
    
    html += '</div>';
    
    paymentsList.innerHTML = html;
    
    // Show total
    totalAmountSpan.textContent = `৳${total.toLocaleString()}`;
    paymentsTotal.style.display = 'block';
    
  } catch (error) {
    console.error('Error loading payments:', error);
    paymentsList.innerHTML = `<div style="text-align: center; padding: 40px; color: #666;">
      Error loading payments: ${error.message}
    </div>`;
    paymentsTotal.style.display = 'none';
  }
}

