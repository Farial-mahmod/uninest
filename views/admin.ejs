// Fetch and display gallery from API
async function fetchGallery() {
  try {
    const res = await fetch('/api/media/aurora');

    if (!res.ok) {
      showEmptyGallery();
      return;
    }

    const data = await res.json();

    if (!data.resource || !Array.isArray(data.resource)) {
      showEmptyGallery();
      return;
    }

    renderGallery(data.resource);

  } catch (err) {
    console.error('Gallery fetch failed:', err);
    showEmptyGallery();
  }
}

function renderGallery(resources) {
  const galleryGrid = document.getElementById('galleryGrid');
  const emptyMessage = document.getElementById('emptyGalleryMessage');

  galleryGrid.innerHTML = '';
  emptyMessage.style.display = resources.length ? 'none' : 'block';

  resources.forEach(resource => {
    const card = document.createElement('div');
    card.className = 'gallery-card';

    const url = resource.url;
    const isVideo = /\.(mp4|webm|mov|avi|mkv)$/i.test(url);

    // Badge
    const badge = document.createElement('span');
    badge.textContent = '';

    // Media
    let media;
    if (isVideo) {
      media = document.createElement('video');
      media.src = url;
      media.muted = true;
      media.playsInline = true;
      media.preload = 'metadata';
    } else {
      media = document.createElement('img');
      media.src = url;
      media.loading = 'lazy';
      media.onerror = () => {
        media.src = 'https://via.placeholder.com/300x200?text=Not+Available';
      };
    }

    // Info
    const info = document.createElement('div');
    info.className = 'gallery-info';
    info.innerHTML = `
      <strong>${resource.name}</strong>
      <div class="subtitle">${resource.description}</div>
      <small>${resource.date}</small>
    `;

    card.append(badge, media, info);
    card.onclick = () => openMedia(isVideo ? 'video' : 'image', url);

    galleryGrid.appendChild(card);
  });
}


function showEmptyGallery() {
  const galleryGrid = document.getElementById('galleryGrid');
  const emptyMessage = document.getElementById('emptyGalleryMessage');
  
  if (galleryGrid && emptyMessage) {
    // Clear existing cards
    const cards = galleryGrid.querySelectorAll('.gallery-card');
    cards.forEach(card => card.remove());
    
    // Show empty message
    emptyMessage.style.display = 'block';
    console.log('Showing empty gallery message');
  }
}

