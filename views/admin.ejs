}

// Function to show/hide loading spinner
function showLoading(show) {
  document.getElementById('loadingSpinner').style.display = show ? 'flex' : 'none';
}

// Function to show message
function showMessage(message, type) {
  // Remove any existing message
  const existingMessage = document.querySelector('.message');
  if (existingMessage) {
    existingMessage.remove();
  }
  
  // Create new message
  const messageDiv = document.createElement('div');
  messageDiv.className = `message ${type}`;
  messageDiv.textContent = message;
  messageDiv.style.display = 'block';
  
  // Insert at the top of modal body
  const modalBody = document.querySelector('.modal-body');
  modalBody.insertBefore(messageDiv, modalBody.firstChild);
  
  // Auto hide after 3 seconds
  setTimeout(() => {
    messageDiv.style.display = 'none';
    messageDiv.remove();
  }, 3000);
}

// Main function to create new project
async function createNewProject(event) {
  event.preventDefault();
  
  const projectName = document.getElementById('projectName').value.trim();
  const projectDescription = document.getElementById('projectDescription').value.trim();
  
  if (!projectName) {
    showMessage('Please enter a project name', 'error');
    return;
  }
  
  // Validate project name (only letters, numbers, spaces)
  const nameRegex = /^[A-Za-z0-9\s]+$/;
  if (!nameRegex.test(projectName)) {
    showMessage('Project name can only contain letters, numbers, and spaces', 'error');
    return;
  }
  
  // Disable submit button and show loading
  const submitBtn = document.querySelector('.submit-btn');
  submitBtn.disabled = true;
  showLoading(true);
  
  try {
    const response = await fetch('/api/projects/create', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ projectName }) // Send as projectName, not name
    });
    
    const result = await response.json();
    
    if (result.success) {
      // Show success message with admin credentials
      const adminInfo = result.admin ? 
        `\n\nAdmin Login:\nMobile: ${result.admin.mobile}\nPassword: ${result.admin.password}` : '';
      
      showMessage(`✅ ${result.message}${adminInfo}`, 'success');
      
      // Clear form
      document.getElementById('projectName').value = '';
      document.getElementById('projectDescription').value = '';
      
      // Close modal after 3 seconds
      setTimeout(() => {
        closeNewProjectModal();
        
        // Optional: Refresh the projects list if you have one
        if (typeof loadProjects === 'function') {
          loadProjects();
        }
      }, 3000);
    } else {
      showMessage(`❌ ${result.message || 'Failed to create project'}`, 'error');
    }
  } catch (error) {
    console.error('Error:', error);
    showMessage('❌ Network error. Please try again.', 'error');
  } finally {
    submitBtn.disabled = false;
    showLoading(false);
  }
}

