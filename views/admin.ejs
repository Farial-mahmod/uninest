<script>

document.addEventListener('DOMContentLoaded', fetchShareholders);

document.addEventListener('DOMContentLoaded', () => {
  fetchShareholders();
  document.getElementById('shareholdersView').style.display = 'block';
});

async function fetchShareholders() {
  try {

    const res = await fetch('/api/shareholder/aurora');
    const shareholders = await res.json();
    const tableBody = document.getElementById('tableBody');
    tableBody.innerHTML = '';

    shareholders.forEach(sh => {
      const totalPaid = sh.payments
        .reduce((sum, p) => sum + (p.amount_paid || 0), 0);

      const status = totalPaid > 0 ? 'Active' : 'Inactive';

      const row = `
        <tr>
          <td>${sh.id}</td>
          <td>${sh.name}</td>
          <td>${sh.flat_number}</td>
          <td>${sh.mobile}</td>
          <td>${totalPaid.toLocaleString()}</td>
        </tr>
      `;

      tableBody.insertAdjacentHTML('beforeend', row);
    });

  } catch (err) {
    console.error('Failed to load shareholders:', err);
  }
}

async function addShareholder() {
  const payload = {
    id: document.getElementById('sh_id').value,
    project: document.getElementById('sh_project').value,
    name: document.getElementById('sh_name').value,
    flat_number: document.getElementById('sh_flat').value,
    email: document.getElementById('sh_email').value,
    mobile: document.getElementById('sh_mobile').value,
    password: document.getElementById('sh_password').value,
    total_installments: document.getElementById('sh_total_installments').value,
    installment_amount: document.getElementById('sh_installment_amount').value
  };

  if (!payload.id || !payload.name || !payload.mobile) {
    return alert('ID, Name & Mobile are required');
  }

  try {
    const res = await fetch(`/api/shareholder/${payload.project}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    if (!res.ok) throw new Error(result.message);

    closeModal();
    showSuccessPopup('Shareholder added successfully');

    // 🔁 reload from DB
    fetchShareholders();

  } catch (err) {
    alert(err.message);
  }
}

async function populatePaymentShareholders() {
  const res = await fetch('/api/shareholder/aurora');
  const shareholders = await res.json();

  const select = document.getElementById('paymentShareholder');
  select.innerHTML = '<option value="">Select shareholder</option>';

  shareholders.forEach(sh => {
    const opt = document.createElement('option');
    opt.value = sh.id;        // IMPORTANT → ID
    opt.textContent = sh.name; // DISPLAY NAME
    select.appendChild(opt);
  });
}

function openPaymentModal() {
  populatePaymentShareholders();
  document.getElementById('paymentModal').classList.add('active');
}

async function submitPayment() {
  const payload = {
    shareholderId: document.getElementById('paymentShareholder').value,
    installment_number: document.getElementById('paymentInstallment').value,
    amount_paid: document.getElementById('paymentAmount').value,
    payment_date: document.getElementById('paymentDate').value
  };

  if (!payload.shareholderId || !payload.installment_number) {
    return alert('All fields are required');
  }

  try {
    const res = await fetch('/api/payment/aurora', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    console.log(result.modifiedCount);
    if (!res.ok) throw new Error(result.message);

    closePaymentModal();
    showSuccessPopup('Payment recorded');

    fetchPayments(); // 🔁 refresh payments list

  } catch (err) {
    alert(err.message);
  }
}

// Fetch and display costs/vouchers
async function fetchCosts() {
  try {
    const res = await fetch('/api/costs/aurora');
    const data = await res.json();
    const tableBody = document.getElementById('costsTableBody');
    
    if (!tableBody) {
      console.error('Costs table body not found!');
      return;
    }
    
    tableBody.innerHTML = '';
    
    // Check if data has the expected structure
    if (!data || !data.cost || !Array.isArray(data.cost)) {
      console.error('Invalid data structure:', data);
      tableBody.innerHTML = `
        <tr>
          <td colspan="8" style="text-align: center; padding: 40px; color: #666">
            No cost data found or invalid format
          </td>
        </tr>
      `;
      return;
    }
    
    const costs = data.cost;
    
    // Debug log
    console.log('Fetched costs:', costs);
    
    if (costs.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="8" style="text-align: center; padding: 40px; color: #666">
            No cost records found. Click "Add Voucher" to add your first expense.
          </td>
        </tr>
      `;
      return;
    }
    
    costs.forEach((cost, index) => {
      // Generate a unique ID if none exists
      const voucherId = cost.voucher_id || `VCH-${new Date().getFullYear()}-${(index + 1).toString().padStart(3, '0')}`;
      
      const row = `
        <tr>
