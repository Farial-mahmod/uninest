async function fetchShareholders() {
  try {
    // Load default project (aurora) on page load
    const response = await fetch('/api/shareholder/aurora');
    const shareholders = await response.json();
    const tableBody = document.getElementById('tableBody');
    tableBody.innerHTML = '';

    if (!shareholders || shareholders.length === 0) {
      tableBody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px; color: #666;">No shareholders found</td></tr>';
      return;
    }

    shareholders.forEach(sh => {
      const totalPaid = (sh.payments || [])
        .reduce((sum, p) => sum + (p.amount_paid || 0), 0);

      const row = `
        <tr>
          <td>${sh.id}</td>
          <td>${sh.name}</td>
          <td>${sh.flat_number}</td>
          <td>${sh.mobile}</td>
          <td>৳${totalPaid.toLocaleString()}</td>
          <td>
            <span style="background: ${sh.role === 'admin' ? '#dc2626' : '#059669'}; 
                         color: white; padding: 4px 8px; border-radius: 12px; font-size: 12px;">
              ${sh.role || 'client'}
            </span>
          </td>
          <td>
            <button onclick="deleteShareholder('aurora', '${sh.id}', '${sh.name}')" 
                    style="background: #dc2626; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px;">
              Delete
            </button>
          </td>
        </tr>
      `;

      tableBody.insertAdjacentHTML('beforeend', row);
    });

  } catch (err) {
    console.error('Failed to load shareholders:', err);
    const tableBody = document.getElementById('tableBody');
    tableBody.innerHTML = `<tr><td colspan="7" style="text-align: center; padding: 40px; color: #666;">
      Error loading shareholders: ${err.message}
    </td></tr>`;
  }
}

