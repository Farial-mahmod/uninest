  z-index: 1;
}

.gallery-info {
  padding: 16px;
}

.gallery-info strong {
  display: block;
  font-size: 16px;
  margin-bottom: 4px;
  color: #333;
}

.gallery-info .subtitle {
  font-size: 14px;
