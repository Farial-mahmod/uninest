// Modified handleFileSelect to include upload
async function handleFileSelect(input) {
  if (!input.files || !input.files.length) return;

  const file = input.files[0];
  const uploadBox = input.closest('.upload-box');
  
  // Show uploading state
  uploadBox.classList.add('uploading');
  uploadBox.innerHTML = `
    ⏳ Uploading...<br>
    <strong>${file.name}</strong>
    <br><small>${(file.size / 1024 / 1024).toFixed(2)} MB</small>
  `;

  try {
    // Get form data
    const mediaType = document.querySelector('#addMediaModal select').value;
    const description = document.querySelector('#addMediaModal input[placeholder*="description"]').value;
    const dateCaptured = document.querySelector('#addMediaModal input[type="date"]').value;
    
    // Upload file
    const uploadedFile = await uploadMedia(file, {
      mediaType,
      description,
      dateCaptured,
      project: 'UniNest Aurora'
    });

    // Update UI with success
    uploadBox.classList.remove('uploading');
    uploadBox.classList.add('upload-success');
    uploadBox.innerHTML = `
      ✅ Uploaded!<br>
      <strong>${file.name}</strong>
      <br><small>View ID: ${uploadedFile.id}</small>
    `;

    // Optionally refresh gallery
    setTimeout(() => {
      loadGallery();
    }, 1500);

  } catch (error) {
    uploadBox.classList.remove('uploading');
    uploadBox.classList.add('upload-error');
    uploadBox.innerHTML = `
      ❌ Upload failed<br>
      <strong>${file.name}</strong>
      <br><small>Click to try again</small>
    `;
    
    // Restore click functionality
    uploadBox.onclick = () => {
      uploadBox.classList.remove('upload-error');
      uploadBox.innerHTML = `⬆ Click to upload or drag and drop<br>
        <small id="upload-hint">
          Photos: JPG/PNG up to 10MB • Videos: MP4 up to 50MB
        </small>`;
      triggerFileUpload();
    };
  }
}

