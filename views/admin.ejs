      </div>
      <h4>Option ${number}</h4>
      <p>${option?.details || 'No details'}</p>
    </div>`;
  }
  
  // Add selected class if this option is selected
  const selectedClass = option.selected ? 'selected' : '';
  
  // Create voters list HTML
  let votersHtml = '';
  if (option.voters && option.voters.length > 0) {
    votersHtml = `
      <div class="voters-list">
        <strong>Selected by:</strong>
        <ul>
          ${option.voters.map(voter => `<li>${voter}</li>`).join('')}
        </ul>
      </div>
    `;
  } else {
    votersHtml = `<div class="voters-list"><em>No selections yet</em></div>`;
