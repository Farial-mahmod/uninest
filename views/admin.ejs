// Function to submit new milestone to API
async function submitMilestone() {
  try {
    // Get form values
    const description = document.getElementById('milestoneDescription').value;
    const planned_date = document.getElementById('milestonePlannedDate').value;
    const completion_date = document.getElementById('milestoneCompletionDate').value;
    const status = document.getElementById('milestoneStatus').value;
    const note = document.getElementById('milestoneNote').value;
    
    // Validate required fields
    if (!description || !planned_date) {
      alert('Description and Planned Date are required');
      return;
    }
    
    // Format dates to DD-MM-YYYY
    const formatDateToDDMMYYYY = (dateString) => {
      if (!dateString) return '';
      const date = new Date(dateString);
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}-${month}-${year}`;
    };
    
    // Prepare payload matching your JSON structure
    const payload = {
      description: description.trim(),
      planned_date: formatDateToDDMMYYYY(planned_date),
      completion_date: completion_date ? formatDateToDDMMYYYY(completion_date) : '',
      status: status,
      note: note ? note.trim() : ''
    };
    
    console.log('Submitting milestone:', payload);
    
    // Send POST request to API
    const res = await fetch('/api/milestones/aurora', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json' 
      },
      body: JSON.stringify(payload)
    });
    
    // Check response
    if (!res.ok) {
      const errorText = await res.text();
      console.error('API Error:', errorText);
      throw new Error(`Failed to add milestone: ${res.status} ${res.statusText}`);
    }
    
    const result = await res.json();
    console.log('API Response:', result);
    
    // Close modal and show success
    closeMilestoneModal();
    showSuccessPopup('Milestone added successfully');
    
    // Refresh milestones list
    fetchMilestones();
    
  } catch (err) {
    console.error('Error adding milestone:', err);
    alert('Error adding milestone: ' + err.message);
  }
}

