async function fetchShareholders() {
  try {

    const res = await fetch('/api/shareholder/aurora');
    const shareholders = await res.json();
    const tableBody = document.getElementById('tableBody');
    tableBody.innerHTML = '';

    shareholders.forEach(sh => {
      const totalPaid = sh.payments
        .reduce((sum, p) => sum + (p.amount_paid || 0), 0);

      const status = totalPaid > 0 ? 'Active' : 'Inactive';

      const row = `
        <tr>
          <td>${sh.id}</td>
          <td>${sh.name}</td>
          <td>${sh.flat_number}</td>
          <td>${sh.mobile}</td>
          <td>${totalPaid.toLocaleString()}</td>
        </tr>
      `;

      tableBody.insertAdjacentHTML('beforeend', row);
    });

  } catch (err) {
    console.error('Failed to load shareholders:', err);
  }
}

async function addShareholder() {
  const payload = {
    id: document.getElementById('sh_id').value,
    project: document.getElementById('sh_project').value,
    name: document.getElementById('sh_name').value,
    flat_number: document.getElementById('sh_flat').value,
    email: document.getElementById('sh_email').value,
    mobile: document.getElementById('sh_mobile').value,
    password: document.getElementById('sh_password').value,
    total_installments: document.getElementById('sh_total_installments').value,
    installment_amount: document.getElementById('sh_installment_amount').value
  };

  if (!payload.id || !payload.name || !payload.mobile) {
    return alert('ID, Name & Mobile are required');
  }

  try {
    const res = await fetch(`/api/shareholder/${payload.project}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    if (!res.ok) throw new Error(result.message);

    closeModal();
    showSuccessPopup('Shareholder added successfully');
    fetchShareholders();
  } catch (err) {
    alert(err.message);
  }
}

async function populatePaymentShareholders() {
  const res = await fetch('/api/shareholder/aurora');
  const shareholders = await res.json();
  const select = document.getElementById('paymentShareholder');
