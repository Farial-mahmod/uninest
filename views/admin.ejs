}

/* ===== FIXED MEDIA MODAL ===== */
#mediaModal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 10000;
  padding: 20px;
  box-sizing: border-box;
}

#mediaModal.active {
  display: flex;
}

/* Fixed container - this is key for stability */
.media-modal-container {
  position: relative;
  width: 800px; /* Fixed width */
  height: 600px; /* Fixed height */
  max-width: 90vw;
  max-height: 85vh;
  background: #111;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
}

/* Modal header */
.media-modal-header {
  flex-shrink: 0;
  padding: 15px 20px;
  background: rgba(0, 0, 0, 0.8);
  border-bottom: 1px solid #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
  font-size: 14px;
}

.media-modal-header .filename {
  font-family: monospace;
  color: #aaa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.media-modal-header .close-btn {
  background: none;
  border: none;
  color: white;
  font-size: 24px;
  cursor: pointer;
  padding: 0;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.3s;
}

.media-modal-header .close-btn:hover {
  background: rgba(255, 255, 255, 0.1);
}

/* Fixed viewport - prevents resizing */
.media-viewport {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  overflow: hidden;
  min-height: 0; /* Important for flex child */
}

/* Fixed image/video styles */
#mediaImage {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
  border-radius: 4px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
}

#mediaVideo {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  display: block;
  border-radius: 4px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
}

/* Modal footer */
.media-modal-footer {
  flex-shrink: 0;
  padding: 12px 20px;
  background: rgba(0, 0, 0, 0.8);
  border-top: 1px solid #333;
  color: #aaa;
  font-size: 13px;
  text-align: center;
}

/* Responsive adjustments */
@media (max-width: 900px) {
  .media-modal-container {
    width: 700px;
    height: 500px;
  }
}

@media (max-width: 768px) {
  .media-modal-container {
    width: 90vw;
    height: 70vh;
    max-height: 70vh;
  }
  
  #mediaModal {
    padding: 10px;
  }
}

@media (max-width: 480px) {
  .media-modal-container {
    width: 95vw;
    height: 60vh;
    max-height: 60vh;
  }
  
  .media-modal-header {
    padding: 12px 15px;
    font-size: 13px;
  }
  
  .media-viewport {
    padding: 10px;
  }
}

/* Optional: Add overlay click to close */
.media-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  cursor: pointer;
  z-index: -1;
}
  
</style>
</head>

