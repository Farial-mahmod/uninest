// Fetch and display milestones from API
async function fetchMilestones() {
  try {
    console.log('Fetching milestones...');
    const res = await fetch('/api/milestones/aurora');
    
    // Check if response is ok
    if (!res.ok) {
      console.log('Milestones API returned:', res.status, res.statusText);
      showEmptyMilestones();
      return;
    }
    
    const data = await res.json();
    console.log('Milestones API response:', data);
    
    const tableBody = document.getElementById('milestonesTableBody');
    
    if (!tableBody) {
      console.error('Milestones table body not found!');
      return;
    }
    
    // Clear existing rows
    tableBody.innerHTML = '';
    
    // Check if data has the expected structure
    if (!data || !data.milestone || !Array.isArray(data.milestone)) {
      console.log('Invalid milestones data structure:', data);
      showEmptyMilestones();
      return;
    }
    
    const milestones = data.milestone;
    
    if (milestones.length === 0) {
      showEmptyMilestones();
      return;
    }
    
    // Render milestones
    milestones.forEach((milestone, index) => {
      const statusColors = {
        'Planned': '#3b82f6',
        'In Progress': '#f59e0b',
        'Completed': '#10b981',
        'Delayed': '#ef4444'
      };
      
      const status = milestone.status || 'Planned';
      const plannedDate = milestone.planned_date || '';
      const completionDate = milestone.completion_date || '';
      
      // Calculate progress based on status
      let progress = 0;
      if (status === 'Completed') progress = 100;
      else if (status === 'In Progress') progress = 50;
      else if (status === 'Delayed') progress = 25;
      else progress = 0;
      
      const row = `
        <tr>
          <td>
            <div style="font-weight: 600;">${milestone.description || 'Untitled Milestone'}</div>
            ${milestone.note ? `<div style="font-size: 12px; color: #666; margin-top: 4px;">
              📝 ${milestone.note}
            </div>` : ''}
          </td>
          <td>
            <div>${plannedDate ? 
              `<div style="font-size: 12px; margin-top: 2px;">
              Started: ${formatDate(plannedDate)}
            </div>` : 'Not set'}</div>

            ${completionDate ? `<div style="font-size: 12px; color: #059669; margin-top: 2px;">
              Completed: ${formatDate(completionDate)}
            </div>` : ''}
          </td>
          <td>
            <span class="status-badge" style="
              background: ${statusColors[status] || '#6b7280'};
              color: white;
              padding: 4px 12px;
              border-radius: 20px;
              font-size: 12px;
              font-weight: 500;
            ">
              ${status}
            </span>
          </td>
          <td>
            <div style="display: flex; align-items: center; gap: 8px;">
              <div style="flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden;">
                <div style="width: ${progress}%; height: 100%; background: ${statusColors[status] || '#6b7280'};"></div>
              </div>
              <span style="font-size: 12px; color: #666; min-width: 30px;">${progress}%</span>
            </div>
          </td>
          <td>
            <button class="btn-small" onclick="openEditMilestoneModal(${index})">Edit</button>
                 </td>
        </tr>
      `;
      tableBody.insertAdjacentHTML('beforeend', row);
    });
  } catch (err) {
    console.error('Failed to load milestones:', err);
    showEmptyMilestones();
  }
}

// Helper function to format date from DD-MM-YYYY to readable format
function formatDate(dateString) {
  if (!dateString) return 'N/A';
  
  try {
    // Handle DD-MM-YYYY format
    const parts = dateString.split('-');
    if (parts.length === 3) {
      const day = parts[0];
      const month = parts[1];
      const year = parts[2];
      return `${day}/${month}/${year}`;
    }
    
    // Try to parse as Date object
    const date = new Date(dateString);
    if (!isNaN(date.getTime())) {
      return date.toLocaleDateString();
    }
    
    return dateString;
  } catch (e) {
    return dateString;
  }
}

function showEmptyMilestones() {
  const tableBody = document.getElementById('milestonesTableBody');
  if (tableBody) {
    tableBody.innerHTML = `
      <tr>
        <td colspan="5" style="text-align: center; padding: 40px; color: #666">
          No milestones found. Click "Add Milestone" to add your first milestone.
        </td>
      </tr>
    `;
  }
}

// Function to submit new milestone to API
async function submitMilestone() {
  try {
    // Get form values
    const description = document.getElementById('milestoneDescription').value;
    const planned_date = document.getElementById('milestonePlannedDate').value;
    const completion_date = document.getElementById('milestoneCompletionDate').value;
    const status = document.getElementById('milestoneStatus').value;
    const note = document.getElementById('milestoneNote').value;
    
    // Validate required fields
    if (!description || !planned_date) {
      alert('Description and Planned Date are required');
      return;
    }
    
    // Format dates to DD-MM-YYYY
    const formatDateToDDMMYYYY = (dateString) => {
      if (!dateString) return '';
      const date = new Date(dateString);
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}-${month}-${year}`;
    };
    
    // Prepare payload matching your JSON structure
    const payload = {
      description: description.trim(),
      planned_date: formatDateToDDMMYYYY(planned_date),
      completion_date: completion_date ? formatDateToDDMMYYYY(completion_date) : '',
      status: status,
      note: note ? note.trim() : ''
    };
    
    console.log('Submitting milestone:', payload);
    
    // Send POST request to API
    const res = await fetch('/api/milestones/aurora', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json' 
      },
      body: JSON.stringify(payload)
    });
    
    // Check response
    if (!res.ok) {
      const errorText = await res.text();
      console.error('API Error:', errorText);
      throw new Error(`Failed to add milestone: ${res.status} ${res.statusText}`);
    }
    
    const result = await res.json();
    console.log('API Response:', result);
    
    // Close modal and show success
    closeMilestoneModal();
    showSuccessPopup('Milestone added successfully');
    
    // Refresh milestones list
    fetchMilestones();
    
  } catch (err) {
    console.error('Error adding milestone:', err);
    alert('Error adding milestone: ' + err.message);
  }
}

