    });
    
    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(errorData.error || `Upload failed: ${response.status}`);
    }
    
    const result = await response.json();
    console.log('Upload successful:', result);
    
    // Update UI with success
    uploadBox.classList.remove('uploading');
    uploadBox.classList.add('upload-success');
    uploadBox.innerHTML = `
      ✅ Uploaded!<br>
      <strong>${file.name}</strong>
      <br><small>Saved to gallery</small>
    `;

    // Show success message
    showSuccessPopup('Media uploaded successfully!');
    
    // MODIFY THIS PART - Replace with page reload
    setTimeout(() => {
      closeAddMediaModal();
      location.reload(); // This reloads the entire page
    }, 2000);

  } catch (error) {
    console.error('Upload error:', error);
    uploadBox.classList.remove('uploading');
    uploadBox.classList.add('upload-error');
    uploadBox.innerHTML = `
      ❌ Upload failed<br>
      <strong>${file.name}</strong>
      <br><small>${error.message}</small>
    `;
    
    // Restore click functionality after 3 seconds
    setTimeout(() => {
      uploadBox.classList.remove('upload-error');
      uploadBox.innerHTML = `⬆ Click to upload or drag and drop<br>
        <small id="upload-hint">
          Photos: JPG/PNG up to 10MB • Videos: MP4 up to 50MB
        </small>`;
      uploadBox.onclick = () => triggerFileUpload();
    }, 3000);
  }
}

