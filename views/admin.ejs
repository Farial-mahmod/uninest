function openMedia(type, src){
  const modal = document.getElementById('mediaModal');
  const img = document.getElementById('mediaImage');
  const video = document.getElementById('mediaVideo');
  const filename = document.getElementById('mediaFilename');
  const info = document.getElementById('mediaInfo');

  // Reset displays
  img.style.display = 'none';
  video.style.display = 'none';
  video.pause();
  
  // Show modal
  modal.classList.add('active');
  
  // Extract filename from URL
  const fileName = src.split('/').pop() || 'media';
  filename.textContent = fileName;
  
  if(type === 'image'){
    img.src = src;
    img.style.display = 'block';
    
    // Force fixed dimensions
    img.style.maxWidth = '100%';
    img.style.maxHeight = '100%';
    img.style.width = 'auto';
    img.style.height = 'auto';
    
    img.onload = function() {
      // info.textContent = `Size: ${img.naturalWidth} × ${img.naturalHeight}px`;
    };
    
    img.onerror = function() {
      info.textContent = 'Failed to load image';
      img.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300"><rect width="400" height="300" fill="#222"/><text x="200" y="150" text-anchor="middle" fill="#666" font-family="Arial" font-size="14">Image not available</text></svg>';
    };
    
  } else {
    video.src = src;
    video.style.display = 'block';
    video.controls = true;
    
    // Force fixed dimensions
    video.style.maxWidth = '100%';
    video.style.maxHeight = '100%';
    video.style.width = 'auto';
    video.style.height = 'auto';
    
    video.onloadedmetadata = function() {
      info.textContent = `Video: ${Math.round(video.duration)}s`;
    };
    
    video.onerror = function() {
      info.textContent = 'Failed to load video';
    };
    
    // Auto-play
    video.play().catch(e => {
      console.log('Auto-play prevented, user interaction required');
      info.textContent = 'Click to play video';
    });
  }
  
  // Close on ESC key
  const handleEscape = function(e) {
    if (e.key === 'Escape') {
      closeMedia();
      document.removeEventListener('keydown', handleEscape);
    }
  };
  document.addEventListener('keydown', handleEscape);
}

