async function addShareholder() {
  // Password validation
  const password = document.getElementById('sh_password').value;
  const confirmPassword = document.getElementById('sh_confirm_password').value;
  
  if (password !== confirmPassword) {
    alert('Password and Confirm Password must match');
    return;
  }

  const role = document.getElementById('sh_role').value;
  
  // Get the selected project from the dropdown
  const projectSelect = document.getElementById('projectSelector');
  const selectedProject = projectSelect.value;
  
  if (!selectedProject) {
    alert('Please select a project first');
    return;
  }

  let flatNumber = '';
  let totalInstallments = '';
  let installmentAmount = '';
  
  if (role === 'admin') {
    flatNumber = '';
    totalInstallments = '';
    installmentAmount = '';
  } else {
    flatNumber = document.getElementById('sh_flat').value;
    totalInstallments = document.getElementById('sh_total_installments').value;
    installmentAmount = document.getElementById('sh_installment_amount').value;
  }

  const payload = {
    id: document.getElementById('sh_id').value,
    project: selectedProject, // Use the selected project
    name: document.getElementById('sh_name').value,
    flat_number: flatNumber,
    email: document.getElementById('sh_email').value,
    mobile: document.getElementById('sh_mobile').value,
    password: document.getElementById('sh_password').value,
    role: role,
    total_installments: totalInstallments,
    installment_amount: installmentAmount
  };

  // Validation
  if (!payload.id || !payload.name || !payload.mobile) {
    return alert('ID, Name & Mobile are required');
  }

  // For clients, validate flat_number and financial fields
  if (role === 'client') {
    if (!payload.flat_number) {
      return alert('Flat Number is required for clients');
    }
    if (!payload.total_installments || !payload.installment_amount) {
      return alert('Total Installments and Installment Amount are required for clients');
    }
  }

  // Show loading state
  const addButton = event.target;
  const originalText = addButton.textContent;
  addButton.textContent = 'Adding...';
  addButton.disabled = true;

  try {
    // Use the selected project in the API URL
    const res = await fetch(`/api/shareholder/${selectedProject}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    
    if (!res.ok) {
      if (result.error && result.error.includes('database')) {
        throw new Error('Database connection failed. Please ensure the project exists.');
      }
      throw new Error(result.message || result.error || 'Failed to add shareholder');
    }

    closeModal();
    showSuccessPopup('Shareholder added successfully');
    
    // Clear form
    document.getElementById('sh_id').value = '';
    document.getElementById('sh_project').value = '';
    document.getElementById('sh_name').value = '';
    document.getElementById('sh_flat').value = '';
    document.getElementById('sh_email').value = '';
    document.getElementById('sh_mobile').value = '';
    document.getElementById('sh_password').value = '';
    document.getElementById('sh_total_installments').value = '';
    document.getElementById('sh_installment_amount').value = '';
    
    // Refresh the shareholders list for the current project
    loadShareholdersForProject();
    
  } catch (err) {
    console.error('Add shareholder error:', err);
    alert(err.message);
  } finally {
    // Reset button state
    addButton.textContent = originalText;
    addButton.disabled = false;
  }
}

async function populatePaymentShareholders() {
  try {
