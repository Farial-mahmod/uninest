async function uploadSelectedFile() {
  const fileInput = document.getElementById('mediaInput');
  const uploadBox = document.getElementById('uploadBox');
  
  if (!fileInput.files || !fileInput.files.length) {
    alert('Please select a file first');
    return;
  }

  const file = fileInput.files[0];
  const mediaName = document.getElementById('mediaName').value;
  const mediaDescription = document.getElementById('mediaDescription').value;
  const mediaDate = document.getElementById('mediaDate').value;
  const project = 'aurora'; // or get from current project
  
  // Validate required fields
  if (!mediaName || !mediaDescription || !mediaDate) {
    alert('Title, Description, and Date are required');
    return;
  }
  
  // Validate file size (50MB limit)
  if (file.size > 50 * 1024 * 1024) {
    alert('File size must be less than 50MB');
    return;
  }
  
  // Show uploading state
  uploadBox.classList.add('uploading');
  uploadBox.innerHTML = `
    ⏳ Uploading...<br>
    <strong>${file.name}</strong>
    <br><small>${(file.size / 1024 / 1024).toFixed(2)} MB</small>
