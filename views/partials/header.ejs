<html>
    <style>
        /* Modal styles */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.5);
    animation: fadeIn 0.3s;
}

.modal-content {
    background-color: #fefefe;
    margin: 10% auto;
    padding: 0;
    border-radius: 10px;
    width: 80%;
    max-width: 600px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    animation: slideIn 0.3s;
}

.modal-header {
    padding: 20px;
    background-color: #4CAF50;
    color: white;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h2 {
    margin: 0;
    font-size: 24px;
}

.close {
    color: white;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    transition: color 0.3s;
}

.close:hover {
    color: #f1f1f1;
}

.modal-body {
    padding: 30px;
    line-height: 1.6;
    color: #333;
}

.modal-body p {
    font-size: 16px;
    margin-bottom: 20px;
}

.project-info {
    background-color: #f9f9f9;
    padding: 15px;
    border-radius: 8px;
    margin-top: 15px;
}

.project-info h3 {
    margin: 0 0 10px 0;
    color: #4CAF50;
    font-size: 18px;
}

.project-info ul {
    margin: 0;
    padding-left: 20px;
}

.project-info li {
    margin: 8px 0;
    color: #555;
}

.modal-footer {
    padding: 15px 20px;
    background-color: #f1f1f1;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    text-align: right;
}

.btn-close {
    background-color: #4CAF50;
    color: white;
    border: none;
    padding: 10px 25px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.3s;
}

.btn-close:hover {
    background-color: #45a049;
}

/* Animations */
@keyframes fadeIn {
    from {opacity: 0;}
    to {opacity: 1;}
}

@keyframes slideIn {
    from {
        transform: translateY(-50px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}
    </style>

<header class="header">
    <div class="logo">
        <i class="fas fa-chart-line"></i>
        <span>Dashboard</span>
    </div>

    <div class="user-menu" id="userMenu">
        <div class="user-avatar">
            <i class="fas fa-user"></i>
        </div>
        <span class="user-name">Profile</span>
        <i class="fas fa-chevron-down"></i>
        <!-- DROPDOWN -->
        <div class="user-dropdown hidden" id="userDropdown">
            <a href="#" class="dropdown-item" onclick="openProjectDetails(event)">
                <i class="fas fa-user-circle"></i>
                Project Details
            </a>
            <a href="/api/logout" class="dropdown-item logout">
                <i class="fas fa-sign-out-alt"></i>
                Logout
            </a>
        </div>
    </div>
</header>

<!-- Project Details Modal -->
<div id="projectModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="projectModalTitle">Project Details</h2>
            <span class="close" onclick="closeProjectDetails()">&times;</span>
        </div>
        <div class="modal-body">
            <!-- Loading spinner -->
            <div id="projectDetailsLoading" class="loading-spinner" style="display: none; text-align: center; padding: 20px;">
                <div class="spinner"></div>
                <p>Loading project details...</p>
            </div>
            
            <!-- Error message -->
            <div id="projectDetailsError" class="error-message" style="display: none; color: #dc2626; padding: 20px; text-align: center;">
                Failed to load project details. Please try again.
            </div>
            
            <!-- Project content (hidden by default) -->
            <div id="projectDetailsContent" style="display: none;">
                <!-- Project image -->
                <div class="project-image-container" style="margin-bottom: 20px; text-align: center;">
                    <img id="projectImage" src="" alt="Project Image" style="max-width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                </div>
                
                <!-- Project description -->
                <div id="projectDescription" class="project-description" style="margin-bottom: 20px; line-height: 1.6; color: #333;">
                </div>
                
                <!-- Project info (optional - can be removed if not needed) -->
                <div class="project-info" style="margin-top: 20px;">
                    <h3>Key Features:</h3>
                    <ul id="projectFeatures">
                        <li>Prime location near Hatirjheel</li>
                        <li>Modern amenities</li>
                        <li>Vibrant community atmosphere</li>
                        <li>Heart of Dhaka city</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- <div class="modal-footer">
            <button class="btn-close" onclick="closeProjectDetails()">Close</button>
        </div> -->
    </div>
</div>

<style>
/* Loading spinner styles */
.loading-spinner .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 10px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.project-description {
    font-size: 16px;
    color: #4a5568;
}

.project-image-container {
    background: #f7f9fc;
    padding: 10px;
    border-radius: 8px;
}

.project-info {
    background: #f7f9fc;
    padding: 15px;
    border-radius: 8px;
    border-left: 4px solid #667eea;
}

.project-info h3 {
    margin-top: 0;
    margin-bottom: 10px;
    color: #2d3748;
    font-size: 18px;
}

.project-info ul {
    margin: 0;
    padding-left: 20px;
    color: #4a5568;
}

.project-info li {
    margin-bottom: 8px;
}
</style>

<script>
// Store current project name (you need to set this from your server-side)
let currentProject = '<%= project %>'; // This should be passed from your server when rendering

// Function to fetch and display project details
async function loadProjectDetails() {
    const loading = document.getElementById('projectDetailsLoading');
    const error = document.getElementById('projectDetailsError');
    const content = document.getElementById('projectDetailsContent');
    const title = document.getElementById('projectModalTitle');
    
    // Show loading, hide error and content
    loading.style.display = 'block';
    error.style.display = 'none';
    content.style.display = 'none';
    
    try {
        console.log('Loading project details for:', currentProject);
        
        const response = await fetch(`/api/project/${currentProject}/details`);
        const result = await response.json();
        
        if (result.success) {
            // Update modal title
            title.textContent = `${result.project.displayName} - Project Details`;
            
            // Update image if exists
            const projectImage = document.getElementById('projectImage');
            if (result.project.image) {
                projectImage.src = result.project.image;
                projectImage.alt = result.project.displayName;
                projectImage.style.display = 'block';
            } else {
                projectImage.style.display = 'none';
            }
            
            // Update description
            const description = document.getElementById('projectDescription');
            if (result.project.data) {
                description.innerHTML = `<p><strong>${result.project.displayName}</strong> ${result.project.data}</p>`;
            } else {
                description.innerHTML = `<p><strong>${result.project.displayName}</strong> is situated at the heart of Dhaka city in a vibrant location near Hatirjheel. It has a modern vibe with all the modern facilities.</p>`;
            }
            
            // Hide loading, show content
            loading.style.display = 'none';
            content.style.display = 'block';
        } else {
            throw new Error(result.message || 'Failed to load project details');
        }
        
    } catch (err) {
        console.error('Error loading project details:', err);
        
        // Hide loading, show error
        loading.style.display = 'none';
        error.style.display = 'block';
        
        // Optional: Show fallback content
        content.style.display = 'none';
    }
}

function openProjectDetails(event) {
    event.preventDefault(); // Prevent the default link behavior
    
    // Load project details when opening modal
    loadProjectDetails();
    
    // Show modal
    document.getElementById('projectModal').style.display = 'block';
    
    // Close the user dropdown when opening modal
    document.getElementById('userDropdown').classList.add('hidden');
}

function closeProjectDetails() {
    document.getElementById('projectModal').style.display = 'none';
}

// Close modal if user clicks outside of it
window.onclick = function(event) {
    const modal = document.getElementById('projectModal');
    if (event.target == modal) {
        closeProjectDetails();
    }
}

// Close modal with Escape key
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeProjectDetails();
    }
});

function toggleMenu() {
    document.getElementById('userDropdown').classList.toggle('hidden');
}

// Close dropdown when clicking outside
document.addEventListener('click', function(event) {
    const userMenu = document.getElementById('userMenu');
    const dropdown = document.getElementById('userDropdown');
    
    if (!userMenu.contains(event.target) && !dropdown.classList.contains('hidden')) {
        dropdown.classList.add('hidden');
    }
});

</script>

</html>